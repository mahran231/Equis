# Public URL of the site, without a trailing slash (used for canonical URLs, hreflang, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: configure only if an approved enquiry-delivery provider is selected.
# Without these, the contact form stays disabled and shows an honest notice.
#
# ENQUIRY_PROVIDER=resend   -> ENQUIRY_PROVIDER_API_KEY = Resend API key
#                              ENQUIRY_DESTINATION      = inbox that receives enquiries
#                              ENQUIRY_FROM             = verified sender, e.g. "EQUIS <enquiries@your-domain>"
# ENQUIRY_PROVIDER=webhook  -> ENQUIRY_DESTINATION      = https:// endpoint that accepts JSON POSTs
#                              ENQUIRY_PROVIDER_API_KEY = optional bearer token sent to that endpoint
ENQUIRY_PROVIDER=
ENQUIRY_PROVIDER_API_KEY=
ENQUIRY_DESTINATION=
ENQUIRY_FROM=
